{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@buzz/author": ["./.author/types/plugins/author.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "test"]
}
