+// Match Buzz's exact visibility flags; display-type fallback is not public evidence.
+fn channel_is_explicitly_public(tags: &[serde_json::Value]) -> bool {
+    let flags: Vec<_> = tags
+        .iter()
+        .filter_map(|tag| tag.as_array())
+        .filter(|tag| {
+            matches!(
+                tag.first().and_then(|value| value.as_str()),
+                Some("public" | "private")
+            )
+        })
+        .collect();
+    let types: Vec<_> = tags
+        .iter()
+        .filter_map(|tag| tag.as_array())
+        .filter(|tag| tag.first().and_then(|value| value.as_str()) == Some("t"))
+        .collect();
+    flags.len() == 1
+        && flags[0].as_slice() == [serde_json::Value::from("public")]
+        && types.len() == 1
+        && types[0].as_slice()
+            == [
+                serde_json::Value::from("t"),
+                serde_json::Value::from("stream"),
+            ]
+        && !tags.iter().any(|tag| {
+            tag.as_array()
+                .is_some_and(|tag| tag.first().and_then(|value| value.as_str()) == Some("hidden"))
+        })
+}
