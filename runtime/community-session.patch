+                let tags = if i >= 4 {
+                    unknown[i - 4]
+                        .as_array()
+                        .unwrap()
+                        .iter()
+                        .map(|tag| {
+                            Tag::parse(tag.as_array().unwrap().iter().map(|v| v.as_str().unwrap()))
+                                .unwrap()
+                        })
+                        .collect::<Vec<_>>()
+                } else {
+                    vec![
+                        Tag::parse(["d", &channel.to_string()]).unwrap(),
+                        Tag::parse(["name", &format!("wire-{i}")]).unwrap(),
+                        Tag::parse(["t", if i == 3 { "dm" } else { "stream" }]).unwrap(),
+                        Tag::parse([if i == 2 || i == 3 {
+                            "private"
+                        } else {
+                            "public"
+                        }])
+                        .unwrap(),
+                    ]
+                };
+                serde_json::to_value(
+                    EventBuilder::new(Kind::Custom(39000), "")
+                        .tags(tags)
+                        .sign_with_keys(&Keys::generate())
+                        .unwrap(),
+                )
+                .unwrap()
+            })
+            .collect();
+        let canvases: Vec<_> = channels
+            .iter()
+            .map(|channel| {
+                serde_json::to_value(
+                    EventBuilder::new(Kind::Custom(buzz_core::kind::KIND_CANVAS as u16), "canvas")
+                        .tags([Tag::parse(["h", &channel.to_string()]).unwrap()])
+                        .sign_with_keys(&Keys::generate())
+                        .unwrap(),
+                )
+                .unwrap()
+            })
+            .collect();
+        let expected_canvases: Vec<_> = canvases
+            .iter()
+            .map(|v| v["id"].as_str().unwrap().to_string())
+            .collect();
+        let server_channels = channels.clone();
+        let app = Router::new()
+            .route(
+                "/query",
