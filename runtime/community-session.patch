+    async fn community_wire_lifecycle(protocol_error: bool) {
+        use axum::{routing::post, Json, Router};
+        let channels: Vec<_> = (0..4).map(|_| Uuid::new_v4()).collect();
+        let channel_events: Vec<_> = channels
+            .iter()
+            .enumerate()
+            .map(|(i, channel)| {
+                serde_json::to_value(
+                    EventBuilder::new(Kind::Custom(39000), "")
+                        .tags([
+                            Tag::parse(["d", &channel.to_string()]).unwrap(),
+                            Tag::parse(["name", &format!("wire-{i}")]).unwrap(),
+                            Tag::parse([
+                                "t",
+                                if i == 2 {
+                                    "private"
+                                } else if i == 3 {
+                                    "dm"
+                                } else {
+                                    "stream"
+                                },
+                            ])
+                            .unwrap(),
+                        ])
+                        .sign_with_keys(&Keys::generate())
+                        .unwrap(),
+                )
+                .unwrap()
+            })
+            .collect();
+        let canvases: Vec<_> = channels
+            .iter()
+            .map(|channel| {
+                serde_json::to_value(
+                    EventBuilder::new(Kind::Custom(buzz_core::kind::KIND_CANVAS as u16), "canvas")
+                        .tags([Tag::parse(["h", &channel.to_string()]).unwrap()])
+                        .sign_with_keys(&Keys::generate())
+                        .unwrap(),
+                )
+                .unwrap()
+            })
+            .collect();
+        let expected_canvases: Vec<_> = canvases
+            .iter()
+            .map(|v| v["id"].as_str().unwrap().to_string())
+            .collect();
+        let server_channels = channels.clone();
+        let app = Router::new()
+            .route(
+                "/query",
+                post(move |Json(filters): Json<serde_json::Value>| {
+                    let channels = server_channels.clone();
+                    let metadata = channel_events.clone();
+                    let canvases = canvases.clone();
+                    async move {
+                        let filter = &filters[0];
+                        let result = if filter["kinds"][0] == 39000 {
+                            channels
+                                .iter()
+                                .position(|c| filter["#d"][0] == c.to_string())
+                                .map(|i| vec![metadata[i].clone()])
+                                .unwrap_or_default()
+                        } else if filter["kinds"][0] == buzz_core::kind::KIND_CANVAS {
+                            channels
+                                .iter()
+                                .position(|c| filter["#h"][0] == c.to_string())
+                                .map(|i| vec![canvases[i].clone()])
+                                .unwrap_or_default()
+                        } else {
+                            vec![]
+                        };
+                        Json(result)
+                    }
+                }),
+            )
+            .route(
+                "/events",
+                post(|| async { Json(serde_json::json!({"accepted": true})) }),
+            );
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let base_url = format!("http://{}", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        let capture = tempfile::NamedTempFile::new().unwrap();
+        let script = r#"import json,sys
+count=0
+for line in sys.stdin:
+ r=json.loads(line)
+ with open(sys.argv[1], 'a') as f: f.write(line)
+ if 'id' not in r: continue
+ if r['method']=='session/new':
+  count+=1; result={'sessionId':str(count)}
+ elif r['method']=='session/prompt' and 'fail-community-history' in json.dumps(r['params']):
+  result={} # Malformed prompt response reaches the production Protocol error path.
+ else: result={'stopReason':'end_turn'}
+ print(json.dumps({'jsonrpc':'2.0','id':r['id'],'result':result}),flush=True)
+"#;
+        let acp = AcpClient::spawn(
+            "python3",
+            &[
+                "-u".into(),
+                "-c".into(),
+                script.into(),
+                capture.path().to_string_lossy().into(),
+            ],
+            &[],
+            false,
+        )
+        .await
+        .unwrap();
+        let mut agent = OwnedAgent {
+            index: 0,
+            acp,
+            state: SessionState::default(),
+            model_capabilities: None,
+            desired_model: None,
+            model_overridden: false,
+            desired_model_request_id: None,
+            desired_model_pending_ack: false,
+            startup_effort: None,
+            agent_name: String::new(),
+            goose_system_prompt_supported: None,
+            protocol_version: 2,
+        };
+        agent.protocol_version = 2;
+        agent.agent_name = "buzz-agent".into();
+        let mut ctx = make_prompt_context_no_owner();
+        ctx.session_policy = crate::scope::SessionPolicy::Community;
+        ctx.rest_client.base_url = base_url;
+        ctx.channel_info = ChannelInfoResolver::new(HashMap::new(), ctx.rest_client.clone());
+        let ctx = Arc::new(ctx);
+        let (tx, mut rx) = mpsc::unbounded_channel();
+        let mut session_ids = vec![];
+        let mut public_a = None;
+        let turns: &[usize] = if protocol_error {
+            &[0, 1, 2, 3, 0, 1, 0, 0, 1]
+        } else {
+            &[0, 1, 2, 3, 0, 1, 0]
+        };
+        for (turn, &i) in turns.iter().enumerate() {
+            if turn == 5 {
+                // Idle !rotate uses this pool seam. Reset A, then resume B.
+                let mut pool = AgentPool::from_slots(vec![Some(agent)]);
+                assert_eq!(pool.invalidate_scope_session(public_a.as_ref().unwrap()), 1);
+                agent = pool.try_claim(None).unwrap();
+            }
+            let content = if protocol_error && turn == 7 {
+                "fail-community-history".to_string()
+            } else {
+                format!("turn-{i}")
+            };
+            let event = EventBuilder::new(Kind::Custom(9), content)
+                .sign_with_keys(&Keys::generate())
+                .unwrap();
+            let batch = FlushBatch {
+                channel_id: channels[i],
+                scope: if i == 3 {
+                    conv(channels[i])
+                } else {
+                    SessionScope::Thread {
+                        channel_id: channels[i],
+                        root_event_id: event.id.to_hex(),
+                    }
+                },
+                events: vec![crate::queue::BatchEvent {
+                    edit: None,
+                    event,
+                    prompt_tag: "@mention".into(),
+                    received_at: std::time::Instant::now(),
+                }],
+                cancelled_events: vec![],
+                cancel_reason: None,
+            };
+            let scope = batch.scope.clone();
+            if turn == 0 {
+                public_a = Some(scope.clone());
+            }
+            run_prompt_task(
+                agent,
+                Some(batch),
+                None,
+                Arc::clone(&ctx),
+                tx.clone(),
+                None,
+                format!("turn-{i}"),
+            )
+            .await;
+            let result = rx.recv().await.unwrap();
+            assert_eq!(result.source.scope(), Some(&scope));
+            if protocol_error && turn == 7 {
+                assert!(matches!(
+                    result.outcome,
+                    PromptOutcome::Error(AcpError::Protocol(_))
+                ));
+                assert!(
+                    result.agent.state.shared_session.is_none(),
+                    "A's protocol error must reset shared history"
+                );
+                assert!(result.agent.state.shared_scopes.is_empty());
+                assert!(
+                    result.agent.state.sessions.keys().all(|route| {
+                        route.channel_id() != channels[0] && route.channel_id() != channels[1]
+                    }),
+                    "A's protocol error must detach B's aliases too"
+                );
+                assert_eq!(
+                    result.agent.state.sessions.len(),
+                    2,
+                    "private and DM sessions must survive"
+                );
+            } else {
+                assert!(matches!(
+                    result.outcome,
+                    PromptOutcome::Ok(StopReason::EndTurn)
+                ));
+                session_ids.push(result.agent.state.sessions[&scope].clone());
+            }
+            agent = result.agent;
+        }
+        agent.acp.shutdown().await;
+        server.abort();
+        let requests: Vec<serde_json::Value> = std::fs::read_to_string(capture.path())
+            .unwrap()
+            .lines()
+            .map(|l| serde_json::from_str(l).unwrap())
+            .collect();
+        assert_eq!(
+            session_ids[0], session_ids[1],
+            "A → B must resume the same live provider session"
+        );
+        assert_eq!(
+            session_ids[0], session_ids[4],
+            "returning to a new A thread must retain public history"
+        );
+        assert_ne!(
+            session_ids[0], session_ids[2],
+            "private history must be isolated"
+        );
+        assert_ne!(
+            session_ids[0], session_ids[3],
+            "DM history must be isolated"
+        );
+        assert_ne!(
+            session_ids[0], session_ids[5],
+            "idle rotate in A must also reset B's provider history"
+        );
+        assert_eq!(
+            session_ids[5], session_ids[6],
+            "A and B must reuse one fresh history after rotation"
+        );
+        if protocol_error {
+            assert_ne!(
+                session_ids[6], session_ids[7],
+                "B must receive a new sid after A's protocol error"
+            );
+        }
+        let prompts: Vec<_> = requests
+            .iter()
+            .filter(|r| r["method"] == "session/prompt")
+            .collect();
+        for (turn, &channel) in turns.iter().enumerate() {
+            let text = prompts[turn]["params"]["prompt"].to_string();
+            assert!(
