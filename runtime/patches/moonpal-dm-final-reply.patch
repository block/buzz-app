+async fn publish_dm_final_reply(
+    acp: &mut crate::acp::AcpClient,
+    rest: &crate::relay::RestClient,
+    target: Option<&(Uuid, ThreadTags)>,
+) {
+    let Some(text) = acp.take_final_reply() else {
+        return;
+    };
+    let Some((channel, thread)) = target else {
+        return;
+    };
+    let Some(event) = build_failure_notice_event(&rest.keys, *channel, thread, &text) else {
+        return;
+    };
+    // submit_event retries the same signed event; never regenerate inference on
+    // an uncertain publish. A delivery error must be visible in retained logs.
+    let delivery = tokio::time::timeout(Duration::from_secs(15), rest.submit_event(&event)).await;
+    if !matches!(delivery, Ok(Ok(_))) {
+        acp.observe("reply_delivery", serde_json::json!({"status":"failed","eventId":event.id.to_hex(),"message":"Final answer could not be delivered"}));
+        tracing::error!(channel = %channel, event_id = %event.id, "DM final answer delivery failed or timed out");
     }
