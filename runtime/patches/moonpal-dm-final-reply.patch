+// Host-delivered native DM replies: exercise the real ACP worker and fake LLM.
+async fn dm_prompt_to_completion(h: &mut Harness, sid: &str) -> Value {
+    let id = h.send("session/prompt", json!({"sessionId":sid,"prompt":[{"type":"text","text":"What command finds the word space in a Unix document?"}],"_meta":{"buzz":{"replyAsText":true}}})).await;
+    loop {
+        let response = h.recv().await;
+        if response["method"] == "session/request_permission" {
+            h.write(approve_permission(&response)).await;
+        }
+        if response["id"] == id {
+            return response;
+        }
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn dm_final_reply_delivers_answer_without_regeneration() {
+    let llm = spawn_capturing_llm(vec![openai_text("Use grep -n -w space document.txt")]).await;
+    let mut h = Harness::spawn_with_env(&llm.url, &[("BUZZ_AGENT_REQUIRE_REPLY", "1")]).await;
+    let sid = init_session(&mut h, json!([])).await;
+    let response = dm_prompt_to_completion(&mut h, &sid).await;
+    assert_eq!(
+        response["result"]["_meta"]["buzz"]["finalReply"],
+        "Use grep -n -w space document.txt"
+    );
+    assert_eq!(llm.captured.lock().await.len(), 1);
+    h.shutdown().await;
+}
