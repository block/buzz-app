#!/bin/bash
# Do not launch a Python installer alias on machines with no legacy work.
if [ "$#" -eq 0 ]; then
  shopt -s nullglob
  files=("$HOME"/.local/state/buzz-monitor/{monitors,wakes}/*.json)
  if [ "${#files[@]}" -eq 0 ]; then
    echo '[]'
    exit 0
  fi
fi
exec python3 "$(dirname "$0")/buzz-attention-import" "$@"
