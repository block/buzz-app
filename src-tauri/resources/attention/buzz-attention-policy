#!/usr/bin/env python3
"""User-owned GitHub comment policy. JSON data only, never executable policy."""
import json
import os
from pathlib import Path
import re
import sys
import tempfile

FIELDS = ("trustedOrganizations", "trustedAuthors", "ignoredAuthors")

def validate(value):
    if not isinstance(value, dict) or set(value) != {"version", *FIELDS} or value.get("version") != 1:
        raise ValueError("Expected version 1 and trustedOrganizations, trustedAuthors, ignoredAuthors")
    for field in FIELDS:
        values = value[field]
        pattern = r"[A-Za-z0-9][A-Za-z0-9-]*(?:\[bot\])?" if field != "trustedOrganizations" else r"[A-Za-z0-9][A-Za-z0-9-]*"
        if not isinstance(values, list) or any(not isinstance(v, str) or not re.fullmatch(pattern, v) for v in values):
            raise ValueError(f"{field} must contain GitHub logins")
    return value

def location():
    return Path.home() / ".buzz" / "preferences" / "github-pr.json"

def read(path):
    try:
        policy = validate(json.loads(path.read_text()))
        configured = bool(policy["trustedOrganizations"] or policy["trustedAuthors"])
        error = None
    except (OSError, ValueError) as exc:
        policy = {"version": 1, **{key: [] for key in FIELDS}}
        configured, error = False, str(exc)
    warning = None if configured else f"No GitHub author allowlist configured. CI and PR-state monitoring will continue, but comments and reviews won't be delivered. Configure trusted organizations and/or individual commenters in {path} to enable them."
    return {"path": str(path), "policy": policy, "configured": configured, "warning": warning, "error": error}

def write(path, value):
    validate(value)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as file:
            temporary = file.name
            json.dump(value, file, indent=2)
            file.write("\n")
        os.replace(temporary, path)
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)
    return read(path)

if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["read"]:
            result = read(location())
        elif len(sys.argv) == 3 and sys.argv[1] == "write":
            result = write(location(), json.loads(sys.argv[2]))
        else:
            raise ValueError("Expected read or write JSON")
        print(json.dumps(result))
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
