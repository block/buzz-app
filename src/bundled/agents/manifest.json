{
  "id": "buzz.agents",
  "name": "Agents",
  "apiVersion": 1,
  "description": "Create, configure, and manage agents.",
  "discovery": {
    "category": "agents",
    "tags": ["Core", "Essentials", "coding-agents"]
  },
  "host": {
    "mcp": true,
    "files": true,
    "processes": [
      {
        "id": "attention-command",
        "program": "bash",
        "args": ["-c", "exec \"$@\"", "attention"]
      },
      {
        "id": "attention-pr",
        "program": "buzz-attention-pr",
        "bundled": true,
        "interpreter": "bash"
      },
      {
        "id": "attention-import",
        "program": "buzz-attention-import",
        "bundled": true,
        "interpreter": "python3"
      }
    ]
  }
}
