{
  "id": "buzz.claude-code",
  "name": "Claude",
  "apiVersion": 1,
  "host": {
    "networkOrigins": ["https://downloads.claude.ai"],
    "processes": [
      {
        "id": "claude",
        "program": "bash",
        "args": ["claude.sh", "run"]
      },
      {
        "id": "install",
        "program": "bash",
        "args": ["claude.sh", "install"]
      },
      {
        "id": "use",
        "program": "bash",
        "args": ["claude.sh", "use"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
