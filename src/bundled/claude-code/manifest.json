{
  "id": "buzz.claude-code",
  "name": "Claude",
  "apiVersion": 1,
  "description": "Run local Claude coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "networkOrigins": ["https://downloads.claude.ai"],
    "files": true,
    "processes": [
      {
        "id": "read-protected",
        "program": "buzz-agent-command",
        "bundled": true,
        "args": [
          "--shell",
          "case \"$1\" in \"~/\"*) set -- \"$HOME/${1:2}\";; esac; exec /usr/bin/base64 -i \"$1\"",
          "buzz-read"
        ]
      },
      {
        "id": "transcript-protected",
        "program": "buzz-agent-command",
        "bundled": true,
        "args": [
          "--shell",
          "exec /usr/bin/python3 -IS -c \"$1\" \"$2\"",
          "buzz-transcript"
        ]
      },
      {
        "id": "claude-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      },
      { "id": "size", "program": "wc", "args": ["-c"] },
      {
        "id": "read-page",
        "program": "bash",
        "args": [
          "-c",
          "set -o pipefail; dd if=\"$1\" bs=1048576 skip=\"$2\" count=\"$3\" | base64",
          "buzz-read-page"
        ]
      },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "starts",
        "program": "grep",
        "args": [
          "-rHEo",
          "-m1",
          "--include=*.jsonl",
          "-e",
          "Session scope: [a-z ]+",
          "-e",
          "Channel: ([^\\\\]|\\\\[^n])*",
          "-e",
          "Thread root: [0-9a-f]{64}",
          "-e",
          "Agent: [0-9a-f]{64}(@[A-Za-z0-9._~%-]+)?",
          "-e",
          "</?(thread|conversation)-context>"
        ]
      },
      {
        "id": "list",
        "program": "find",
        "args": [".", "-type", "f", "-name", "*.jsonl"]
      },
      {
        "id": "claude-protected-arm64",
        "program": "claude",
        "artifact": {
          "path": "~/Library/Application Support/Buzz/claude-code/2.1.305/claude",
          "sha256": "ea3ea3c08d2a9634a4651e687fcf900d410c489bce2b00f22bd7352b91ba704f"
        }
      },
      {
        "id": "claude-protected-x64",
        "program": "claude",
        "artifact": {
          "path": "~/Library/Application Support/Buzz/claude-code/2.1.305/claude",
          "sha256": "af7ad8d6d8b1e49059988f6657d91bb8b9feac127bf8bec005c4c27d0093f153"
        }
      }
    ]
  }
}
