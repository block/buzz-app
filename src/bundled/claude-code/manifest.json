{
  "id": "buzz.claude-code",
  "name": "Claude",
  "apiVersion": 1,
  "description": "Run local Claude coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "networkOrigins": ["https://downloads.claude.ai"],
    "files": true,
    "processes": [
      {
        "id": "claude-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      },
      { "id": "workspace", "program": "pwd" },
      {
        "id": "owners",
        "program": "grep",
        "args": [
          "-rHEo",
          "-m1",
          "--include=*.jsonl",
          "-e",
          "Agent: [0-9a-f]{64}"
        ]
      },
      {
        "id": "list",
        "program": "find",
        "args": [".", "-type", "f", "-name", "*.jsonl"]
      },
      {
        "id": "find",
        "program": "grep",
        "args": ["-rlF", "--include=*.jsonl", "-e"]
      }
    ]
  }
}
