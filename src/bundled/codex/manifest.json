{
  "id": "buzz.codex",
  "name": "Codex",
  "apiVersion": 1,
  "host": {
    "networkOrigins": ["https://releases.openai.com"],
    "processes": [
      { "id": "login", "program": "codex", "args": ["login"] },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "codex-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
