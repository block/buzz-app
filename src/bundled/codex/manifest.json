{
  "id": "buzz.codex",
  "name": "Codex",
  "apiVersion": 1,
  "host": {
    "processes": [
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "codex-app-server",
        "program": "codex",
        "args": ["app-server"]
      },
      {
        "id": "install",
        "program": "sh",
        "args": ["-c", "curl -fsSL https://chatgpt.com/codex/install.sh | sh"]
      },
      {
        "id": "login",
        "program": "codex",
        "args": ["login"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
