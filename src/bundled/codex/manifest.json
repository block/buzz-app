{
  "id": "buzz.codex",
  "name": "Codex",
  "apiVersion": 1,
  "description": "Run local Codex coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "mcp": true,
    "networkOrigins": ["https://releases.openai.com"],
    "files": true,
    "processes": [
      {
        "id": "read-protected",
        "program": "buzz-agent-command",
        "bundled": true,
        "args": [
          "--shell",
          "case \"$1\" in \"~/\"*) set -- \"$HOME/${1:2}\";; esac; exec /usr/bin/base64 -i \"$1\"",
          "buzz-read"
        ]
      },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "codex-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
