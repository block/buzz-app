{
  "id": "buzz.github",
  "name": "GitHub",
  "apiVersion": 1,
  "description": "View GitHub repositories, pull requests, issues, and commits, and merge pull requests.",
  "discovery": {
    "category": "developer-tools-and-integrations",
    "tags": ["code"]
  },
  "host": {
    "processes": [
      {
        "id": "graphql",
        "program": "gh",
        "args": ["api", "graphql", "--hostname", "github.com", "--input", "-"]
      }
    ],
    "commands": [
      {
        "id": "pull",
        "program": "gh",
        "args": ["api", "graphql", "--hostname", "github.com", "--input", "-"],
        "maxInputBytes": 4096,
        "maxOutputBytes": 1048576
      }
    ]
  }
}
