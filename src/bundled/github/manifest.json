{
  "id": "buzz.github",
  "name": "GitHub",
  "apiVersion": 1,
  "description": "View GitHub repositories, issues, and commits, and merge pull requests.",
  "discovery": {
    "category": "developer-tools-and-integrations",
    "tags": ["code"]
  },
  "host": {
    "processes": [
      {
        "id": "graphql",
        "program": "gh",
        "args": ["api", "graphql", "--hostname", "github.com", "--input", "-"]
      },
      {
        "id": "diff",
        "program": "gh",
        "args": [
          "api",
          "--hostname",
          "github.com",
          "--method",
          "GET",
          "--header",
          "Accept: application/vnd.github.diff"
        ]
      }
    ]
  }
}
