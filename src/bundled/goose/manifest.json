{
  "id": "buzz.goose",
  "name": "Goose",
  "apiVersion": 1,
  "description": "Run local Goose agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "processes": [
      {
        "id": "goose",
        "program": "goose-acp",
        "bundled": true
      },
      {
        "id": "read-protected",
        "program": "buzz-agent-command",
        "bundled": true,
        "args": [
          "--shell",
          "case \"$1\" in \"~/\"*) set -- \"$HOME/${1:2}\";; esac; exec /usr/bin/base64 -i \"$1\"",
          "buzz-read"
        ]
      }
    ],
    "mcp": true,
    "files": true
  }
}
