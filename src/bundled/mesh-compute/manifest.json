{
  "id": "buzz.mesh-compute",
  "name": "Shared compute",
  "description": "Share this computer's compute with your community and run Mesh helper agents.",
  "discovery": {
    "category": "agents"
  },
  "apiVersion": 1,
  "host": {
    "processes": [
      {
        "id": "goose",
        "program": "goose-acp",
        "bundled": true
      },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ],
    "mcp": true
  }
}
