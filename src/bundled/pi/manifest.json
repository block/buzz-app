{
  "id": "buzz.pi",
  "name": "Pi",
  "apiVersion": 1,
  "description": "Run local Pi agents in Buzz.",
  "discovery": { "category": "agents" },
  "host": {
    "processes": [
      {
        "id": "pi-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
